<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="kerangka-berpikir" name="Kerangka Berpikir">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="790" pageHeight="771" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="L0" value="&lt;b&gt;MASALAH&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#1565C0;fontColor=#FFFFFF;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="130" height="108" as="geometry"/></mxCell>
        <mxCell id="C0" value="• Naskah tugas akhir tidak memakai &lt;i&gt;Heading Styles&lt;/i&gt;, sehingga struktur bab dan sub-bab tidak dikenali Word&lt;br&gt;• Penomoran bab, sub-bab, &lt;i&gt;caption&lt;/i&gt;, dan halaman diketik manual dan rusak saat revisi&lt;br&gt;• Pemeriksaan kepatuhan format terhadap Pedoman UEU 2018 masih dilakukan manual&lt;br&gt;• Model klasifikasi tunggal rawan salah konteks, dan belum ada korpus berlabel manusia" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#212121;fontFamily=Times New Roman;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="190" y="40" width="560" height="108" as="geometry"/></mxCell>
        <mxCell id="E0" style="endArrow=none;html=1;strokeColor=#1565C0;strokeWidth=2;" edge="1" parent="1" source="L0" target="C0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="L1" value="&lt;b&gt;SOLUSI&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F57F17;strokeColor=#F57F17;fontColor=#FFFFFF;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="182" width="130" height="127" as="geometry"/></mxCell>
        <mxCell id="C1" value="&lt;b&gt;Asdoku&lt;/b&gt;: &lt;i&gt;Multi-Agent System&lt;/i&gt; berbasis NLP dengan tiga agen:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Agen 1 &lt;i&gt;Inspector&lt;/i&gt;: deteksi struktur paragraf (&lt;i&gt;Random Forest&lt;/i&gt;, TF-IDF + metadata OpenXML)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Agen 2 &lt;i&gt;Quality Critic&lt;/i&gt;: koreksi berbasis aturan pedoman dan konteks dokumen&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Agen 3 &lt;i&gt;Formatting Actuator&lt;/i&gt;: penerapan format pada berkas .docx tanpa mengubah isi" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontColor=#212121;fontFamily=Times New Roman;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="190" y="182" width="560" height="127" as="geometry"/></mxCell>
        <mxCell id="E1" style="endArrow=none;html=1;strokeColor=#F57F17;strokeWidth=2;" edge="1" parent="1" source="L1" target="C1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="L2" value="&lt;b&gt;METODE&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="343" width="130" height="89" as="geometry"/></mxCell>
        <mxCell id="C2" value="• &lt;i&gt;Prototyping&lt;/i&gt; untuk pengembangan perangkat lunak&lt;br&gt;• CRISP-DM untuk komponen &lt;i&gt;machine learning&lt;/i&gt;&lt;br&gt;• Anotasi manual korpus ±10 naskah tugas akhir dan proposal (kappa Cohen)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#212121;fontFamily=Times New Roman;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="190" y="343" width="560" height="89" as="geometry"/></mxCell>
        <mxCell id="E2" style="endArrow=none;html=1;strokeColor=#2E7D32;strokeWidth=2;" edge="1" parent="1" source="L2" target="C2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="L3" value="&lt;b&gt;PENGUJIAN&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#C2185B;strokeColor=#C2185B;fontColor=#FFFFFF;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="466" width="130" height="108" as="geometry"/></mxCell>
        <mxCell id="C3" value="• &lt;i&gt;Macro-F1&lt;/i&gt; terhadap label manual pada dokumen uji terpisah&lt;br&gt;• Uji ablasi: &lt;i&gt;machine learning&lt;/i&gt; saja vs aturan saja vs sistem multi-agen&lt;br&gt;• 8 kriteria format pedoman, verifikasi di Microsoft Word, dan keutuhan isi&lt;br&gt;• &lt;i&gt;Black-box testing&lt;/i&gt; fungsi aplikasi" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;fontColor=#212121;fontFamily=Times New Roman;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="190" y="466" width="560" height="108" as="geometry"/></mxCell>
        <mxCell id="E3" style="endArrow=none;html=1;strokeColor=#C2185B;strokeWidth=2;" edge="1" parent="1" source="L3" target="C3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="L4" value="&lt;b&gt;LUARAN&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#00695C;strokeColor=#00695C;fontColor=#FFFFFF;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="608" width="130" height="89" as="geometry"/></mxCell>
        <mxCell id="C4" value="• Aplikasi web Asdoku&lt;br&gt;• Korpus naskah berlabel dan pedoman anotasi&lt;br&gt;• Artikel ilmiah" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;fontColor=#212121;fontFamily=Times New Roman;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="190" y="608" width="560" height="89" as="geometry"/></mxCell>
        <mxCell id="E4" style="endArrow=none;html=1;strokeColor=#00695C;strokeWidth=2;" edge="1" parent="1" source="L4" target="C4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="A0" style="endArrow=block;endFill=1;html=1;strokeColor=#424242;strokeWidth=2;" edge="1" parent="1" source="L0" target="L1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="A1" style="endArrow=block;endFill=1;html=1;strokeColor=#424242;strokeWidth=2;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="A2" style="endArrow=block;endFill=1;html=1;strokeColor=#424242;strokeWidth=2;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="A3" style="endArrow=block;endFill=1;html=1;strokeColor=#424242;strokeWidth=2;" edge="1" parent="1" source="L3" target="L4"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
